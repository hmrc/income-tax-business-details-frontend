# business details specific routes

#Triggered Migration
GET         /check-your-active-businesses/hmrc-record                     uk.gov.hmrc.incometaxbusinessdetailsfrontend.businessDetails.controllers.triggeredMigration.CheckHmrcRecordsController.show(isAgent: Boolean = false, state: Option[String] ?= None)
GET         /agents/check-your-active-businesses/hmrc-record              uk.gov.hmrc.incometaxbusinessdetailsfrontend.businessDetails.controllers.triggeredMigration.CheckHmrcRecordsController.show(isAgent: Boolean = true, state: Option[String] ?= None)

# Triggered migration – confirm active businesses
